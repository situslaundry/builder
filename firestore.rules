rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Koleksi Users
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) 
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'active';
      allow update: if isAdmin() || (
        isOwner(userId) 
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])
      );
      allow delete: if isAdmin();
    }

    // Koleksi Usernames (Uniqueness check)
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // Koleksi Websites
    match /websites/{websiteId} {
      // Publik hanya bisa membaca website jika status published
      allow read: if (resource.data.status == 'published' && resource.data.published == true)
                  || (isAuthenticated() && resource.data.ownerId == request.auth.uid)
                  || isAdmin();

      // User membuat draft awal
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.published == false
        && request.resource.data.approved == false
        && request.resource.data.plan == 'free';

      // Update oleh User vs Admin
      allow update: if isAdmin() || (
        isAuthenticated() 
        && resource.data.ownerId == request.auth.uid
        // User dilarang memanipulasi published/approved/role/plan
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['published', 'approved', 'plan', 'ownerId', 'username'])
        // User hanya boleh mengganti status ke 'pending_review' atau kembali ke 'draft'
        && (
          request.resource.data.status == resource.data.status ||
          (request.resource.data.status in ['draft', 'pending_review'] && resource.data.status in ['draft', 'rejected', 'pending_review'])
        )
      );

      allow delete: if isAdmin();
    }

    // Koleksi Reports (Publik boleh kirim, Admin review)
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Koleksi Moderation Logs (Hanya Admin)
    match /moderationLogs/{logId} {
      allow create, read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
